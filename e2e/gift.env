# Stand-in gift words for the tests, so the real ones stay out of the repo.
# Loaded by `npm run test:e2e:gift` and by CI for both editions, so the public
# build is checked not to show them.
NEXT_PUBLIC_GIFT_HOME_SCREEN_NAME=Test gift
NEXT_PUBLIC_GIFT_WELCOME_TITLE=Test welcome title
NEXT_PUBLIC_GIFT_WELCOME_MESSAGE=Test welcome message
NEXT_PUBLIC_GIFT_WELCOME_BUTTON=Test start
NEXT_PUBLIC_GIFT_OPENING_MESSAGES=Test opening one|Test opening two
